# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it below (16 letters, no spaces).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
MAIL_TO=you@gmail.com

# Local site
PORT=5050
SITE_URL=http://localhost:5050

